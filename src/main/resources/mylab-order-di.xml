<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

	<bean id="product1" class="mylab.order.di.Product">
		<property name="id" value="P001" />
		<property name="name" value="노트북" />
        <property name="price" value="150000" />
	</bean>
	
	<bean id="product2" class="mylab.order.di.Product">
		<constructor-arg name="id" value="P002" />
		<constructor-arg name="name" value="스마트폰" />
        <constructor-arg name="price" value="800000" />
	</bean>
	
	<bean id="shoppingCart" class="mylab.order.di.ShoppingCart">
		<<property name="products">
            <list>
                <ref bean="product1" />
                <ref bean="product2" />
            </list>
        </property>
    </bean>
</beans>
